@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Access Denied";
}

<div class="py-5">
    <div class="app-card mx-auto text-center" style="max-width:480px;">
        <div class="app-card-body p-5">
            <div class="es-icon mx-auto"><i class="bi bi-shield-lock"></i></div>
            <h1 class="h3 mt-3 mb-2">Access Denied</h1>
            <p class="text-muted">
                We're sorry, but you don't have permission to access this resource. Your current user role
                or membership status doesn't grant you access to this section.
            </p>
            <div class="alert alert-warning d-inline-block text-start my-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Error Code: 403 - Forbidden Access
            </div>
            <p class="text-muted">
                If you believe this is an error or need elevated permissions, please contact the system
                administrator or your membership manager for assistance.
            </p>
            <a asp-action="Index" asp-controller="Home" class="btn btn-fill rounded-pill px-4 py-2 mt-2">
                <i class="bi bi-arrow-left me-2"></i>Return to Home
            </a>
        </div>
    </div>
</div>