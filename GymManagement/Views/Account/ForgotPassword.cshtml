@model GymManagement.BLL.ViewModel.Accounts.ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="text-center mb-4">
    <h1 class="h4 mb-1">Forgot Password</h1>
    <p class="text-muted small mb-0">Enter your email to receive a reset link.</p>
</div>

@if (ViewBag.EmailSent == true)
{
    <div class="alert alert-success">
        <i class="bi bi-info-circle-fill me-2"></i>
        If an account exists for this email, a password reset link has been sent.
    </div>
    @if (!string.IsNullOrEmpty((string?)ViewBag.ResetLink))
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Demo mode:</strong> email sending is not configured, so here is the reset link:
            <div class="mt-1"><a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a></div>
        </div>
    }
    <a asp-action="Login" class="btn btn-soft w-100 rounded-pill py-2">Back to Login</a>
}
else
{
    <form asp-action="ForgotPassword" method="post" class="form-app">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-fill w-100 rounded-pill py-2 mt-2">
            <i class="bi bi-send me-2"></i>Send Reset Link
        </button>
    </form>
    <div class="text-center mt-3">
        <a asp-action="Login" class="small">Back to Login</a>
    </div>
}
