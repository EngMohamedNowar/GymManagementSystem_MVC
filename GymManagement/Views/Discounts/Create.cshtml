@using GymManagementSystem.BLL.ViewModels.Discounts
@model CreateDiscountViewModel

@{
    ViewData["Title"] = "New Discount";
    var header = new PageHeaderModel { Title = "New Discount", Subtitle = "Create a promo code" };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="Create" method="post" class="form-app">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label">Code</label>
                    <input asp-for="Code" class="form-control" placeholder="SUMMER25" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Type" class="form-label">Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Percent">Percent (%)</option>
                        <option value="Fixed">Fixed Amount</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Value" class="form-label">Value</label>
                    <input asp-for="Value" class="form-control" />
                    <span asp-validation-for="Value" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Cancel", Icon = "bi bi-arrow-left", Controller = "Discounts", Action = "Index", CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Create", Icon = "bi bi-check-circle", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
