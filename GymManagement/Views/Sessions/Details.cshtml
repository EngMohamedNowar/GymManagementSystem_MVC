@model SessionViewModel

@{
    ViewData["Title"] = "Session Details";

    var header = new PageHeaderModel
    {
        Title = Model.CategoryName,
        Subtitle = "",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Sessions",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            }
        }
    };

    var statusBadge = Model.Status == "Ongoing" ? "badge-ok" : Model.Status == "Upcoming" ? "badge-soft" : "badge-warn";
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="mb-4">
                <h6 class="section-title">Description</h6>
                <p class="mb-0">@Model.Description</p>
            </div>

            <div class="mb-4">
                <span class="badge-soft @statusBadge">@Model.Status</span>
            </div>

            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Trainer</span>
                    <span class="detail-val">@Model.TrainerName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Start Date</span>
                    <span class="detail-val">@Model.StartDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">End Date</span>
                    <span class="detail-val">@Model.EndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Time</span>
                    <span class="detail-val">@Model.TimeRangeDisplay</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Duration</span>
                    <span class="detail-val">@($"{Model.Duration.Hours}h {Model.Duration.Minutes}m")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Capacity / Booked</span>
                    <span class="detail-val">@($"{Model.AvailableSlots} / {Model.Capacity}")</span>
                </div>
            </div>
        </div>
    </div>
</div>
