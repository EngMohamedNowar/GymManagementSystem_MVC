@model SessionViewModel

@{
    ViewData["Title"] = "Session Details";

    var header = new PageHeaderModel
    {
        Title = Model.CategoryName,
        Subtitle = "",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to List",
                Icon = "bi bi-arrow-left",
                Controller = "Sessions",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            }
        }
    };

    var statusBadge = Model.Status == "Ongoing" ? "badge-ok" : Model.Status == "Upcoming" ? "badge-soft" : "badge-warn";
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="mb-4">
                <h6 class="section-title"><i class="bi bi-file-text me-2"></i>Description</h6>
                <p class="mb-0">@Model.Description</p>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="badge-soft @statusBadge">@Model.Status</span>
            </div>

            @await Html.PartialAsync("_DetailList", new DetailListModel
            {
                Items = new List<DetailItem>
                {
                    new DetailItem { Key = "<i class=\"bi bi-person me-2\"></i>Trainer", Value = Model.TrainerName },
                    new DetailItem { Key = "<i class=\"bi bi-calendar me-2\"></i>Start Date", Value = Model.StartDate.ToString("MMM dd, yyyy") },
                    new DetailItem { Key = "<i class=\"bi bi-calendar-x me-2\"></i>End Date", Value = Model.EndDate.ToString("MMM dd, yyyy") },
                    new DetailItem { Key = "<i class=\"bi bi-clock me-2\"></i>Time", Value = Model.TimeRangeDisplay },
                    new DetailItem { Key = "<i class=\"bi bi-hourglass-split me-2\"></i>Duration", Value = $"{Model.Duration.Hours}h {Model.Duration.Minutes}m" },
                    new DetailItem { Key = "<i class=\"bi bi-people me-2\"></i>Capacity / Booked", Value = $"{Model.AvailableSlots} / {Model.Capacity}" }
                }
            })
        </div>
    </div>
</div>