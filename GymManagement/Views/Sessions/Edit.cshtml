@model UpdateSessionViewModel

@{
    ViewData["Title"] = "Edit Session";

    var header = new PageHeaderModel
    {
        Title = "Edit Session",
        Subtitle = "Update session information",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Sessions",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            }
        }
    };

    var backAction = new FormAction
    {
        Text = "Cancel",
        Icon = "bi bi-arrow-left",
        Controller = "Sessions",
        Action = "Index",
        CssClass = "btn-soft rounded-pill px-3"
    };

    var submitAction = new FormAction
    {
        Text = "Update Session",
        Icon = "bi bi-check-lg",
        CssClass = "btn-fill rounded-pill px-3"
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <form asp-action="Edit" method="post" class="form-app">
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <div class="section-title">Session Information</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TrainerId" class="form-label">
                                <i class="bi bi-person-workspace me-2"></i>Trainer <span class="text-danger">*</span>
                            </label>
                            <select asp-for="TrainerId" asp-items="ViewBag.Trainers" class="form-select">
                                <option value="">Select Trainer</option>
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-card-text me-2"></i>Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="section-title">Date & Time</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">
                                <i class="bi bi-calendar-event me-2"></i>Start Date & Time <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">
                                <i class="bi bi-calendar-event me-2"></i>End Date & Time <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_FormActions", new FormActionsModel
                {
                    BackAction = backAction,
                    SubmitAction = submitAction
                })
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}