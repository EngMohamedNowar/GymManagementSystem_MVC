@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<SessionViewModel>

@{
    ViewData["Title"] = "Sessions";

    var header = new PageHeaderModel
    {
        Title = "Training Sessions",
        Subtitle = "Manage gym training sessions and classes",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Add Session",
                Icon = "bi bi-plus-lg",
                Controller = "Sessions",
                Action = "Create",
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };

    var search = new SearchFormModel
    {
        Controller = "Sessions",
        Action = "Index",
        SearchLabel = "Search",
        SearchPlaceholder = "Title, trainer or category",
        SearchValue = ViewBag.Search?.ToString() ?? ""
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-calendar-x",
        Title = "No Sessions Available",
        Message = "Create your first training session to get started.",
        Action = new EmptyStateAction
        {
            Text = "Add Session",
            Icon = "bi bi-plus-lg",
            Controller = "Sessions",
            Action = "Create",
            CssClass = "btn-fill rounded-pill px-3"
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)
    @await Html.PartialAsync("_SearchForm", search)

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>Trainer</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="cell-strong">@session.CategoryName</div>
                                    <div class="cell-sub">@session.Description</div>
                                </td>
                                <td>@session.TrainerName</td>
                                <td>@session.DateDisplay</td>
                                <td>@session.TimeRangeDisplay</td>
                                <td>@session.AvailableSlots / @session.Capacity</td>
                                <td>
                                    <span class="badge-soft @(session.Status == "Ongoing" ? "badge-ok" : session.Status == "Upcoming" ? "" : "badge-warn")">@session.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-action="Details" asp-route-id="@session.Id">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn-icon" title="Edit" asp-action="Edit" asp-route-id="@session.Id">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn-icon btn-danger-soft" title="Delete" asp-action="Delete" asp-route-id="@session.Id">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>