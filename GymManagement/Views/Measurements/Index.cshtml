@using GymManagementSystem.BLL.ViewModels.BodyMeasurements
@using GymManagementSystem.BLL.ViewModels.Members
@using System.Text.Json
@model IEnumerable<BodyMeasurementViewModel>

@{
    ViewData["Title"] = "Body Measurements";
    var members = (IEnumerable<MemberViewModel>?)ViewBag.Members;
    var memberId = ViewBag.MemberId as int?;

    var ordered = (Model is not null) ? Model.OrderBy(x => x.Date).ToList() : new List<BodyMeasurementViewModel>();
    var labelsJson = JsonSerializer.Serialize(ordered.Select(x => x.Date.ToString("yyyy-MM-dd")));
    var weightsJson = JsonSerializer.Serialize(ordered.Select(x => x.Weight));
    var fatsJson = JsonSerializer.Serialize(ordered.Select(x => x.BodyFat));

    var header = new PageHeaderModel
    {
        Title = "Body Measurements",
        Subtitle = "Track your fitness progress over time",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Add Measurement",
                Icon = "bi bi-plus-lg",
                Controller = "Measurements",
                Action = "Create",
                RouteValues = new Dictionary<string, string> { { "memberId", memberId?.ToString() ?? "" } },
                CssClass = "btn-fill rounded-pill px-3"
            }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-activity",
        Title = "No Measurements Yet",
        Message = "Start tracking your weight and body fat.",
        Action = new EmptyStateAction
        {
            Text = "Add Measurement",
            Icon = "bi bi-plus-lg",
            Controller = "Measurements",
            Action = "Create",
            RouteValues = new Dictionary<string, string> { { "memberId", memberId?.ToString() ?? "" } },
            CssClass = "btn-fill rounded-pill px-3"
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    @if (members is not null && members.Any())
    {
        <form asp-action="Index" method="get" class="form-app mb-3" style="max-width:420px;">
            <select name="memberId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Choose member --</option>
                @foreach (var m in members)
                {
                    <option value="@m.Id" selected="@(memberId == m.Id)">@m.Name</option>
                }
            </select>
        </form>
    }

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="app-card">
                    <div class="app-card-body">
                        <h6 class="mb-3"><i class="bi bi-graph-up me-2"></i>Progress Chart</h6>
                        <canvas id="progressChart" height="140"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="app-card">
                    <div class="app-card-body">
                        <h6 class="mb-3"><i class="bi bi-list-ul me-2"></i>Records</h6>
                        <div class="table-responsive">
                            <table class="table-app">
                                <thead>
                                    <tr><th>Date</th><th>Weight</th><th>Body Fat</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.OrderByDescending(x => x.Date))
                                    {
                                        <tr>
                                            <td>@m.Date.ToString("yyyy-MM-dd")</td>
                                            <td>@m.Weight kg</td>
                                            <td>@(m.BodyFat?.ToString("0.##") ?? "—")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (ordered.Any())
            {
                <text>
                var labels = @Html.Raw(labelsJson);
                var weights = @Html.Raw(weightsJson);
                var fats = @Html.Raw(fatsJson);

                var ctx = document.getElementById("progressChart").getContext("2d");
                new Chart(ctx, {
                    type: "line",
                    data: {
                        labels: labels,
                        datasets: [
                            { label: "Weight (kg)", data: weights, borderColor: "#4f46e5", backgroundColor: "rgba(79,70,229,.15)", tension: 0.3, fill: true },
                            { label: "Body Fat (%)", data: fats, borderColor: "#f59e0b", backgroundColor: "rgba(245,158,11,.15)", tension: 0.3, fill: true }
                        ]
                    },
                    options: { responsive: true, scales: { y: { beginAtZero: false } } }
                });
                </text>
            }
        });
    </script>
}
