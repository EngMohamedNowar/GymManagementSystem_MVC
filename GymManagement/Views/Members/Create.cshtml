@model CreateMemberDTOs

@{
    ViewData["Title"] = "Add Member";
    var header = new PageHeaderModel { Title = "Add Member", Subtitle = "Create a new gym member and their health record" };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-app">
            <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-info" type="button" role="tab">Member Info</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health-info" type="button" role="tab">Health Data</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="member-info" role="tabpanel">
                    <div class="section-title mb-2">Personal Information</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img id="photoPreview" alt="Photo Preview" class="avatar-lg" style="display:none;" />
                                <div class="flex-grow-1">
                                    <label asp-for="Photo" class="form-label"></label>
                                    <input asp-for="Photo" class="form-control" id="photoInput" />
                                    <span asp-validation-for="Photo" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                <option value="">Select...</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="section-title mt-3 mb-2">Address</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BuildingNumber" class="form-label">Building Number</label>
                            <input asp-for="BuildingNumber" class="form-control" />
                            <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Street" class="form-label">Street</label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="health-info" role="tabpanel">
                    <div class="section-title mb-2">Health Data</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.Height" class="form-label">Height</label>
                            <input asp-for="HealthRecordViewModel.Height" class="form-control" />
                            <span asp-validation-for="HealthRecordViewModel.Height" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.Weight" class="form-label">Weight</label>
                            <input asp-for="HealthRecordViewModel.Weight" class="form-control" />
                            <span asp-validation-for="HealthRecordViewModel.Weight" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.BloodType" class="form-label">Blood Type</label>
                            <select asp-for="HealthRecordViewModel.BloodType" class="form-select"
                                    asp-items="@(new SelectList(new[] { new { Value = "A+", Text = "A+" }, new { Value = "A-", Text = "A-" }, new { Value = "B+", Text = "B+" }, new { Value = "B-", Text = "B-" }, new { Value = "AB+", Text = "AB+" }, new { Value = "AB-", Text = "AB-" }, new { Value = "O+", Text = "O+" }, new { Value = "O-", Text = "O-" } }, "Value", "Text"))">
                                <option value="">Select...</option>
                            </select>
                            <span asp-validation-for="HealthRecordViewModel.BloodType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Note" class="form-label">Note</label>
                            <input asp-for="Note" class="form-control" />
                            <span asp-validation-for="Note" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Back", Icon = "bi bi-arrow-left", Controller = "Members", Action = "Index", CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Add Member", Icon = "bi bi-plus-circle", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('photoInput')?.addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('photoPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
