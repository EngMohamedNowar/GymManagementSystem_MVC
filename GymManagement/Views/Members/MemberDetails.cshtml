@model MemberViewModel

@{
    ViewData["Title"] = "Member Details";

    var header = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = Model.PlanName ?? "No Plan",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Members",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Edit",
                Icon = "bi bi-pencil",
                Controller = "Members",
                Action = "EditMember",
                RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Delete",
                Icon = "bi bi-trash",
                Controller = "Members",
                Action = "Delete",
                RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
                CssClass = "btn-danger-soft rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="app-card">
                <div class="app-card-body">
                    <div class="text-center mb-4">
                        @if (Model.Photo is null)
                        {
                            <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
                        }
                        else
                        {
                            <img class="avatar-lg" src="@Url.Action("Picture", "Members", new { id = Model.Id })" alt="@Model.Name" />
                        }
                    </div>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-key">Member ID</span>
                            <span class="detail-val">#@Model.Id</span>
                        </div>
                        @if (Model.MembershipId.HasValue)
                        {
                            <div class="detail-row">
                                <span class="detail-key">Membership No.</span>
                                <span class="detail-val">MEM-@Model.MembershipId.Value.ToString("D5")</span>
                            </div>
                        }
                        <div class="detail-row">
                            <span class="detail-key">Email</span>
                            <span class="detail-val">@Model.Email</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Phone</span>
                            <span class="detail-val">@Model.Phone</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Gender</span>
                            <span class="detail-val">@Model.Gender</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Date of Birth</span>
                            <span class="detail-val">@Model.DateOfBirth</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Membership Start</span>
                            <span class="detail-val">@Model.MemberShipStartDate</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Membership End</span>
                            <span class="detail-val">@Model.MemberShipEndDate</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Address</span>
                            <span class="detail-val">@Model.Address</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="app-card">
                <div class="app-card-header">
                    <h6 class="app-card-title">Check-In QR Code</h6>
                </div>
                <div class="app-card-body text-center">
                    <div id="qr-code" class="mb-3"></div>
                    <p class="text-muted small mb-0">Scan to check in this member</p>
                    @if (Model.MembershipId.HasValue)
                    {
                        <p class="mt-2"><span class="badge bg-primary">MEM-@Model.MembershipId.Value.ToString("D5")</span></p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qr-code"), {
            text: "@Model.Id",
            width: 200,
            height: 200,
            colorDark: "#1a1a2e",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
        });
    </script>
}
