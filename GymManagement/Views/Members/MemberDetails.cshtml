@model MemberViewModel

@{
    ViewData["Title"] = "Member Details";
}

<div class="container">
    <div class="page-header">
        <div class="ph-text">
            <h1>@Model.Name</h1>
            <p>@(Model.PlanName ?? "No Plan")</p>
        </div>
        <div class="d-inline-flex gap-2">
            <a asp-controller="Members" asp-action="Index" class="btn btn-outline rounded-pill px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <a asp-controller="Members" asp-action="EditMember" asp-route-id="@Model.Id" class="btn btn-fill rounded-pill px-3 py-2">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-controller="Members" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger-soft rounded-pill px-3 py-2">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <div class="text-center mb-4">
                @if (Model.Photo is null)
                {
                    <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
                }
                else
                {
                    <img class="avatar-lg" src="@Url.Action("Picture", "Members", new { id = Model.Id })" alt="@Model.Name" />
                }
            </div>

            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Email</span>
                    <span class="detail-val">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Phone</span>
                    <span class="detail-val">@Model.Phone</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Gender</span>
                    <span class="detail-val">@Model.Gender</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Date of Birth</span>
                    <span class="detail-val">@Model.DateOfBirth</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Membership Start Date</span>
                    <span class="detail-val">@Model.MemberShipStartDate</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Membership End Date</span>
                    <span class="detail-val">@Model.MemberShipEndDate</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Address</span>
                    <span class="detail-val">@Model.Address</span>
                </div>
            </div>
        </div>
    </div>
</div>
