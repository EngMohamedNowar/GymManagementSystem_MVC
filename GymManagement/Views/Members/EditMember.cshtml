@model UpdateMemberDTOs

@{
    ViewData["Title"] = "Edit Member";

    var header = new PageHeaderModel
    {
        Title = "Edit Member",
        Subtitle = "Update @Model.Name's contact and address details",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to List",
                Icon = "bi bi-arrow-left",
                Controller = "Members",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            }
        }
    };

    var backAction = new FormAction
    {
        Text = "Cancel",
        Icon = "bi bi-arrow-left",
        Controller = "Members",
        Action = "Index",
        CssClass = "btn-outline rounded-pill px-4"
    };

    var submitAction = new FormAction
    {
        Text = "Done",
        Icon = "bi bi-check-circle",
        CssClass = "btn-fill rounded-pill px-4"
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="text-center mb-4">
                <img src="/Members/Picture/@Context.Request.RouteValues["id"]" alt="@Model.Name" class="avatar-lg" />
            </div>

            <form asp-controller="Members" asp-action="EditMember" asp-route-id="@Context.Request.RouteValues["id"]" method="post" class="form-app">
                <input type="hidden" asp-for="DateOfBirth" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-2"></i>Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label"><i class="bi bi-phone me-2"></i>Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="BuildingNumber" class="form-label"><i class="bi bi-hash me-2"></i>Building Number</label>
                        <input asp-for="BuildingNumber" class="form-control" />
                        <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label"><i class="bi bi-building me-2"></i>City</label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Street" class="form-label"><i class="bi bi-geo-alt me-2"></i>Street</label>
                        <input asp-for="Street" class="form-control" />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>
                </div>

                @await Html.PartialAsync("_FormActions", new FormActionsModel
                {
                    BackAction = backAction,
                    SubmitAction = submitAction
                })
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}