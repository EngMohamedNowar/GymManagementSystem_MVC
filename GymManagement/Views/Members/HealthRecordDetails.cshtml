@model HealthRecordViewModel

@{
    ViewData["Title"] = "Health Record";

    var header = new PageHeaderModel
    {
        Title = "Health Record",
        Subtitle = "Member fitness and medical metrics",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to List",
                Icon = "bi bi-arrow-left",
                Controller = "Members",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            @await Html.PartialAsync("_DetailList", new DetailListModel
            {
                Items = new List<DetailItem>
                {
                    new DetailItem { Key = "<i class=\"bi bi-arrow-up-right-circle me-2\"></i>Height", Value = $"{Model.Height} <small>cm</small>" },
                    new DetailItem { Key = "<i class=\"bi bi-arrow-down-right-circle me-2\"></i>Weight", Value = $"{Model.Weight} <small>kg</small>" },
                    new DetailItem { Key = "<i class=\"bi bi-droplet me-2\"></i>Blood Type", Value = Model.BloodType?.ToString() ?? "—" },
                    new DetailItem { Key = "<i class=\"bi bi-info-circle me-2\"></i>Note", Value = Model.Note ?? "—" }
                }
            })
        </div>
    </div>
</div>