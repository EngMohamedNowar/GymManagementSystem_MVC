@model HealthRecordViewModel

@{
    ViewData["Title"] = "Health Record";

    var header = new PageHeaderModel
    {
        Title = "Health Record",
        Subtitle = "Member fitness metrics",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Members",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Height</span>
                    <span class="detail-val">@Model.Height <small>cm</small></span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Weight</span>
                    <span class="detail-val">@Model.Weight <small>kg</small></span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Blood Type</span>
                    <span class="detail-val">@(Model.BloodType?.ToString() ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Note</span>
                    <span class="detail-val">@(Model.Note ?? "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>
