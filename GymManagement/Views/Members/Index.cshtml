@using GymManagementSystem.BLL.ViewModels.Members
@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<MemberViewModel>

@{
    ViewData["Title"] = "Members";

    var header = new PageHeaderModel
    {
        Title = "Members",
        Subtitle = "Manage gym members and their subscriptions",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Export CSV",
                Icon = "bi bi-download",
                Controller = "Members",
                Action = "ExportCsv",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Add Member",
                Icon = "bi bi-person-plus",
                Controller = "Members",
                Action = "Create",
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };

    var search = new SearchFormModel
    {
        Controller = "Members",
        Action = "Index",
        SearchLabel = "Search",
        SearchPlaceholder = "Name, email or phone",
        SearchValue = ViewBag.Search?.ToString() ?? "",
        Filters = new List<SearchFilter>
        {
            new SearchFilter
            {
                Name = "gender",
                Label = "Gender",
                Value = ViewBag.Gender?.ToString() ?? "",
                Options = new List<SelectOption>
                {
                    new SelectOption { Value = "Male", Text = "Male" },
                    new SelectOption { Value = "Female", Text = "Female" }
                }
            }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-people",
        Title = "No Members Yet",
        Message = "Add your first member to get started.",
        Action = new EmptyStateAction
        {
            Text = "Add Member",
            Icon = "bi bi-person-plus",
            Controller = "Members",
            Action = "Create",
            CssClass = "btn-fill rounded-pill px-3"
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)
    @await Html.PartialAsync("_SearchForm", search)

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Email</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (member.Photo is null)
                                        {
                                            <span class="avatar">@(string.IsNullOrEmpty(member.Name) ? "?" : member.Name[0].ToString())</span>
                                        }
                                        else
                                        {
                                            <img class="avatar" src="@Url.Action("Picture", "Members", new { id = member.Id })" alt="@member.Name" />
                                        }
                                        <div>
                                            <div class="cell-strong">@member.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@member.Email</td>
                                <td>@member.Gender</td>
                                <td>@member.Phone</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-controller="Members" asp-action="MemberDetails" asp-route-id="@member.Id">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn-icon" title="Health Record" asp-controller="Members" asp-action="HealthRecordDetails" asp-route-id="@member.Id">
                                            <i class="bi bi-heart-pulse"></i>
                                        </a>
                                        <a class="btn-icon" title="Edit" asp-controller="Members" asp-action="EditMember" asp-route-id="@member.Id">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn-icon btn-danger-soft" title="Delete" asp-controller="Members" asp-action="Delete" asp-route-id="@member.Id">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>