@using GymManagementSystem.BLL.ViewModels.Members
@using GymManagementSystem.BLL.ViewModels.Memberships
@model MemberViewModel

@{
    ViewData["Title"] = "My Dashboard";
    var memberships = (IEnumerable<MembershipViewModel>?)ViewBag.Memberships;
    var payments = (IEnumerable<GymManagementSystem.BLL.ViewModels.Payments.PaymentViewModel>?)ViewBag.Payments;
}

<div class="container">
    @if (Model is null)
    {
        <div class="app-card">
            <div class="empty-state">
                <div class="es-icon"><i class="bi bi-person-x"></i></div>
                <h4>No Member Profile</h4>
                <p>Your account is not linked to a member profile yet. Please contact the gym administrator.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-fill rounded-pill px-3">Back to Home</a>
            </div>
        </div>
        return;
    }

    <div class="page-header">
        <div class="ph-text">
            <h1>Welcome, @Model.Name</h1>
            <p>Your personal fitness dashboard</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar" style="width:64px;height:64px;font-size:1.5rem;">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
                        <div>
                            <h5 class="mb-0">@Model.Name</h5>
                            <span class="text-muted small">@Model.Email</span>
                        </div>
                    </div>
                    <hr />
                    <div class="detail-list">
                        <div class="detail-row"><span>Phone</span><strong>@Model.Phone</strong></div>
                        <div class="detail-row"><span>Plan</span><strong>@(Model.PlanName ?? "—")</strong></div>
                        <div class="detail-row"><span>Membership Starts</span><strong>@Model.MemberShipStartDate</strong></div>
                        <div class="detail-row"><span>Membership Ends</span><strong>@Model.MemberShipEndDate</strong></div>
                    </div>
                    <div class="d-grid gap-2 mt-3">
                        <a asp-action="MyProfile" class="btn btn-soft rounded-pill"><i class="bi bi-person me-1"></i>Edit Profile</a>
                        <a asp-action="MyQR" class="btn btn-soft rounded-pill"><i class="bi bi-qr-code me-1"></i>My QR Code</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="app-card mb-4">
                <div class="app-card-body">
                    <h5 class="mb-3"><i class="bi bi-credit-card me-2"></i>My Membership</h5>
                    @if (memberships is not null && memberships.Any())
                    {
                        foreach (var ms in memberships)
                        {
                            var badge = ms.Status == "Active" ? "badge-ok" : (ms.Status == "Expired" ? "badge-bad" : "badge-warn");
                            <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-2">
                                <div>
                                    <div class="fw-semibold">@ms.PlanName</div>
                                    <small class="text-muted">@ms.StartDate.ToString("yyyy-MM-dd") → @ms.EndDate.ToString("yyyy-MM-dd")</small>
                                </div>
                                <span class="badge @badge">@ms.Status</span>
                            </div>
                        }
                        <a asp-action="MyMembership" class="btn btn-fill rounded-pill mt-2"><i class="bi bi-receipt me-1"></i>View Payments</a>
                    }
                    else
                    {
                        <p class="text-muted">You have no active membership.</p>
                    }
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <h5 class="mb-3"><i class="bi bi-lightning me-2"></i>Quick Links</h5>
                    <div class="row g-2">
                        <div class="col-6 col-md-4">
                            <a asp-action="MyBookings" class="btn btn-soft w-100 rounded-pill py-3"><i class="bi bi-calendar-check d-block fs-4 mb-1"></i>My Bookings</a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a asp-controller="Measurements" asp-action="Index" class="btn btn-soft w-100 rounded-pill py-3"><i class="bi bi-activity d-block fs-4 mb-1"></i>My Progress</a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a asp-action="MyQR" class="btn btn-soft w-100 rounded-pill py-3"><i class="bi bi-qr-code d-block fs-4 mb-1"></i>Check-in QR</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
