@using GymManagementSystem.BLL.ViewModels.Memberships
@model SubscribeViewModel

@{
    ViewData["Title"] = "Subscribe to a Plan";
    var plans = (IEnumerable<PlanSelectViewModel>?)ViewBag.Plans;
    var header = new PageHeaderModel { Title = "Subscribe to a Plan", Subtitle = "Choose a plan and pay securely with Stripe" };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
            <div class="app-card">
                <div class="app-card-body">
                    <form asp-action="Subscribe" method="post" id="subscribeForm" class="form-app">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="PlanId" class="form-label">Select Plan</label>
                            <select asp-for="PlanId" class="form-select" id="planSelect">
                                <option value="">-- Choose a plan --</option>
                                @if (plans is not null)
                                {
                                    foreach (var p in plans)
                                    {
                                        <option value="@p.Id" data-price="@p.Price" data-duration="@p.DurationDays">@p.Name — @p.Price.ToString("C") / @p.DurationDays days</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PlanId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DiscountCode" class="form-label">Discount Code <span class="text-muted">(optional)</span></label>
                            <input asp-for="DiscountCode" class="form-control" placeholder="e.g. SUMMER25" />
                            <span asp-validation-for="DiscountCode" class="text-danger small"></span>
                        </div>

                        <div class="app-card mb-4" id="orderSummary" style="display:none;">
                            <div class="app-card-body py-3">
                                <div class="detail-list">
                                    <div class="detail-row">
                                        <span class="detail-key">Plan</span>
                                        <span class="detail-val" id="summaryPlan">—</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-key">Duration</span>
                                        <span class="detail-val" id="summaryDuration">—</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-key fw-bold">Total</span>
                                        <span class="detail-val fw-bold fs-5 text-primary-color" id="summaryTotal">—</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-fill w-100 rounded-pill py-2" id="payBtn">
                            <i class="bi bi-shield-lock me-2"></i>Pay with Stripe
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="Index" class="small text-decoration-none text-muted">
                                <i class="bi bi-arrow-left me-1"></i>Back to dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="app-card mt-3">
                <div class="app-card-body py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="feature-icon" style="width:40px;height:40px;font-size:1rem;border-radius:10px;">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div>
                            <h6 class="mb-0" style="font-size:.85rem;">Secure Payment by Stripe</h6>
                            <p class="text-muted mb-0" style="font-size:.78rem;">Your payment info is encrypted. We never store your card details.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('#planSelect').on('change', function () {
                var opt = $(this).find(':selected');
                if (opt.val()) {
                    var price = parseFloat(opt.data('price'));
                    var days = opt.data('duration');
                    var formatted = price.toLocaleString('en-US', { style: 'currency', currency: 'EGP' });
                    $('#summaryPlan').text(opt.text().split('—')[0].trim());
                    $('#summaryDuration').text(days + ' days');
                    $('#summaryTotal').text(formatted);
                    $('#orderSummary').slideDown(200);
                } else {
                    $('#orderSummary').slideUp(200);
                }
            });

            $('#subscribeForm').on('submit', function () {
                if ($(this).valid()) {
                    $('#payBtn').prop('disabled', true).html('<i class="bi bi-hourglass-split me-2"></i>Redirecting to Stripe...');
                }
            });
        });
    </script>
}
