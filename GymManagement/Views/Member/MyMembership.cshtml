@using GymManagementSystem.BLL.ViewModels.Memberships
@using GymManagementSystem.BLL.ViewModels.Payments
@model IEnumerable<MembershipViewModel>

@{
    ViewData["Title"] = "My Membership";
    var member = (GymManagementSystem.BLL.ViewModels.Members.MemberViewModel?)ViewBag.Member;

    var header = new PageHeaderModel
    {
        Title = "My Membership",
        Subtitle = $"{member?.Name ?? "Member"} — subscriptions & payments"
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-credit-card",
        Title = "No Memberships",
        Message = "You don't have any membership yet."
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    @if (Model is not null && Model.Any())
    {
        foreach (var ms in Model)
        {
            var badge = ms.Status == "Active" ? "badge-ok" : ms.Status == "Expired" ? "badge-bad" : "badge-warn";
            <div class="app-card mb-4">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">@ms.PlanName</h5>
                        <span class="badge-soft @badge">@ms.Status</span>
                    </div>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-key">Start</span>
                            <span class="detail-val">@ms.StartDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">End</span>
                            <span class="detail-val">@ms.EndDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-key">Plan Price</span>
                            <span class="detail-val">@ms.Price.ToString("C")</span>
                        </div>
                    </div>

                    <h6 class="text-muted mt-4">Payments</h6>
                    @{
                        var payments = (IEnumerable<PaymentViewModel>?)ViewBag.Payments;
                        var hasPayments = payments is not null && payments.Any(p => p.MembershipId == ms.Id);
                    }
                    @if (hasPayments)
                    {
                        <div class="table-responsive">
                            <table class="table-app">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th>Amount</th>
                                        <th>Reference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in payments.Where(p => p.MembershipId == ms.Id))
                                    {
                                        <tr>
                                            <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                            <td>@p.Method</td>
                                            <td>@p.Amount.ToString("C")</td>
                                            <td>@(p.Reference ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No payments recorded yet.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
        <div class="text-center mt-3">
            <a asp-action="Subscribe" class="btn btn-fill rounded-pill px-4"><i class="bi bi-credit-card me-1"></i> Subscribe Now</a>
        </div>
    }
</div>
