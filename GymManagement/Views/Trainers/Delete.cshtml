@model TrainerViewModel

@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="container">
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <div class="page-header">
            <div class="ph-text">
                <h1>Delete Trainer</h1>
                <p>This action cannot be undone</p>
            </div>
            <div class="d-inline-flex gap-2">
                <a asp-controller="Trainers" asp-action="Index" class="btn btn-outline rounded-pill px-3 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
                <button type="submit" class="btn btn-danger-soft rounded-pill px-3 py-2">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>

        <div class="app-card">
            <div class="app-card-body">
                <div class="text-center mb-4">
                    <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
                    <h4 class="mt-3 mb-0">@Model.Name</h4>
                    <span class="badge-soft mt-2 d-inline-block">@Model.Specialization Trainer</span>
                </div>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Warning!</strong> This action cannot be undone. All trainer data will be permanently deleted.
                </div>

                <div class="detail-list">
                    <div class="detail-row">
                        <span class="detail-key">Name</span>
                        <span class="detail-val">@Model.Name</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Email</span>
                        <span class="detail-val">@Model.Email</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Phone</span>
                        <span class="detail-val">@Model.Phone</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-key">Specialization</span>
                        <span class="detail-val">@Model.Specialization</span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
