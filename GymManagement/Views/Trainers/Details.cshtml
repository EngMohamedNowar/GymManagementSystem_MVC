@model TrainerViewModel

@{
    ViewData["Title"] = "Trainer Details";

    var header = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = $"{Model.Specialization} Trainer",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Trainers",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Edit",
                Icon = "bi bi-pencil",
                Controller = "Trainers",
                Action = "Edit",
                RouteValues = new { id = Model.Id },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Delete",
                Icon = "bi bi-trash",
                Controller = "Trainers",
                Action = "Delete",
                RouteValues = new { id = Model.Id },
                CssClass = "btn-danger-soft rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="text-center mb-4">
                <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
            </div>

            @await Html.PartialAsync("_DetailList", new DetailListModel
            {
                Items = new List<DetailItem>
                {
                    new DetailItem { Key = "<i class=\"bi bi-envelope me-2\"></i>Email", Value = Model.Email },
                    new DetailItem { Key = "<i class=\"bi bi-phone me-2\"></i>Phone", Value = Model.Phone },
                    new DetailItem { Key = "<i class=\"bi bi-gender-ambiguous me-2\"></i>Gender", Value = Model.Gender },
                    new DetailItem { Key = "<i class=\"bi bi-calendar me-2\"></i>Date of Birth", Value = Model.DateOfBirth?.ToString("MMM dd, yyyy") ?? "—" },
                    new DetailItem { Key = "<i class=\"bi bi-geo-alt me-2\"></i>Address", Value = Model.Address ?? "—" },
                    new DetailItem { Key = "<i class=\"bi bi-award me-2\"></i>Specialization", Value = Model.Specialization }
                }
            })
        </div>
    </div>
</div>