@model TrainerViewModel

@{
    ViewData["Title"] = "Trainer Details";

    var header = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = $"{Model.Specialization} Trainer",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Trainers",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Edit",
                Icon = "bi bi-pencil",
                Controller = "Trainers",
                Action = "Edit",
                RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Delete",
                Icon = "bi bi-trash",
                Controller = "Trainers",
                Action = "Delete",
                RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
                CssClass = "btn-danger-soft rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="text-center mb-4">
                <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString())</span>
            </div>

            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Email</span>
                    <span class="detail-val">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Phone</span>
                    <span class="detail-val">@Model.Phone</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Gender</span>
                    <span class="detail-val">@Model.Gender</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Date of Birth</span>
                    <span class="detail-val">@(Model.DateOfBirth != null ? Model.DateOfBirth : "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Address</span>
                    <span class="detail-val">@(Model.Address ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Specialization</span>
                    <span class="detail-val">@Model.Specialization</span>
                </div>
            </div>
        </div>
    </div>
</div>
