@using GymManagementSystem.BLL.ViewModels.Trainers
@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<TrainerViewModel>

@{
    ViewData["Title"] = "Trainers";

    var header = new PageHeaderModel
    {
        Title = "Trainers",
        Subtitle = "Professional fitness instructors",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Add Trainer",
                Icon = "bi bi-person-plus",
                Controller = "Trainers",
                Action = "Create",
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };

    var search = new SearchFormModel
    {
        Controller = "Trainers",
        Action = "Index",
        SearchLabel = "Search",
        SearchPlaceholder = "Name, email or specialty",
        SearchValue = ViewBag.Search?.ToString() ?? ""
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-person-workspace",
        Title = "No Trainers Yet",
        Message = "Add your first trainer to get started.",
        Action = new EmptyStateAction
        {
            Text = "Add Trainer",
            Icon = "bi bi-person-plus",
            Controller = "Trainers",
            Action = "Create",
            CssClass = "btn-fill rounded-pill px-3"
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)
    @await Html.PartialAsync("_SearchForm", search)

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Trainer</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Specialization</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar">@(string.IsNullOrEmpty(trainer.Name) ? "?" : trainer.Name[0].ToString())</span>
                                        <div>
                                            <div class="cell-strong">@trainer.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@trainer.Email</td>
                                <td>@trainer.Phone</td>
                                <td><span class="badge-soft">@trainer.Specialization</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn-icon" title="Edit" asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn-icon btn-danger-soft" title="Delete" asp-controller="Trainers" asp-action="Delete" asp-route-id="@trainer.Id">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>