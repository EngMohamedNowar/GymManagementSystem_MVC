@using GymManagementSystem.BLL.ViewModels.Trainers
@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<TrainerViewModel>
@{ ViewData["Title"] = "Trainers"; }

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel { Title = "Trainers", Subtitle = "Professional fitness instructors", Actions = new List<PageHeaderAction> { new PageHeaderAction { Text = "Add Trainer", Icon = "bi bi-person-plus", Controller = "Trainers", Action = "Create", CssClass = "btn-fill rounded-pill px-3 py-2" } } })

    <form method="get" class="mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Name, email or specialty" value="@ViewBag.Search" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-fill btn-sm px-3"><i class="bi bi-search me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-soft btn-sm px-3">Clear</a>
            </div>
        </div>
    </form>

    @if (Model?.Items?.Any() == true)
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Trainer</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Specialization</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar">@(string.IsNullOrEmpty(t.Name) ? "?" : t.Name[0].ToString())</span>
                                        <span class="cell-strong">@t.Name</span>
                                    </div>
                                </td>
                                <td>@t.Email</td>
                                <td>@t.Phone</td>
                                <td><span class="badge-soft">@t.Specialization</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-action="Details" asp-route-id="@t.Id"><i class="bi bi-eye"></i></a>
                                        <a class="btn-icon" title="Edit" asp-action="Edit" asp-route-id="@t.Id"><i class="bi bi-pencil"></i></a>
                                        <a class="btn-icon btn-danger-soft" title="Delete" asp-action="Delete" asp-route-id="@t.Id"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi bi-person-workspace", Title = "No Trainers Yet", Message = "Add your first trainer to get started.", Action = new EmptyStateAction { Text = "Add Trainer", Icon = "bi bi-person-plus", Controller = "Trainers", Action = "Create" } })
    }
</div>
