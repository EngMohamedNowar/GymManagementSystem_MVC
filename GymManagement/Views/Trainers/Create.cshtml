@model CreateTrainerDTOs

@{
    ViewData["Title"] = "Add Trainer";

    var header = new PageHeaderModel
    {
        Title = "Add Trainer",
        Subtitle = "Register a new fitness instructor",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to List",
                Icon = "bi bi-arrow-left",
                Controller = "Trainers",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            }
        }
    };

    var backAction = new FormAction
    {
        Text = "Cancel",
        Icon = "bi bi-arrow-left",
        Controller = "Trainers",
        Action = "Index",
        CssClass = "btn-outline-secondary rounded-pill px-4"
    };

    var submitAction = new FormAction
    {
        Text = "Add Trainer",
        Icon = "bi bi-plus-circle",
        CssClass = "btn-fill rounded-pill px-4"
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <form method="post" asp-action="Create" class="form-app">
                <div class="section-title">Personal Information</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label"><i class="bi bi-person me-2"></i>Name</label>
                        <input asp-for="Name" type="text" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-2"></i>Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label"><i class="bi bi-phone me-2"></i>Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"><i class="bi bi-calendar me-2"></i>Date of Birth</label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Gender" class="form-label"><i class="bi bi-gender-ambiguous me-2"></i>Gender</label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>

                <div class="section-title mt-4">Address Information</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="BuildingNumber" class="form-label"><i class="bi bi-hash me-2"></i>Building Number</label>
                        <input asp-for="BuildingNumber" class="form-control" />
                        <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Street" class="form-label"><i class="bi bi-geo-alt me-2"></i>Street</label>
                        <input asp-for="Street" class="form-control" />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label"><i class="bi bi-building me-2"></i>City</label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <div class="section-title mt-4">Professional Information</div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Specialization" class="form-label"><i class="bi bi-award me-2"></i>Specialization</label>
                        <select asp-for="Specialization" asp-items="Html.GetEnumSelectList<Specialization>()" class="form-select">
                            <option value="">-- Select Specialist --</option>
                        </select>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                @await Html.PartialAsync("_FormActions", new FormActionsModel
                {
                    BackAction = backAction,
                    SubmitAction = submitAction
                })
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}