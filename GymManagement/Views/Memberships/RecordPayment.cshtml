@using GymManagementSystem.BLL.ViewModels.Payments
@model CreatePaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
    var header = new PageHeaderModel { Title = "Record Payment", Subtitle = Model.MembershipLabel };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="RecordPayment" method="post" class="form-app">
            <input type="hidden" asp-for="MembershipId" />

            <div class="mb-3">
                <label class="form-label">Membership</label>
                <input type="text" class="form-control" value="@Model.MembershipLabel" disabled />
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Method" class="form-label">Method</label>
                    <select asp-for="Method" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="BankTransfer">Bank Transfer</option>
                        <option value="Renewal">Renewal</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Reference" class="form-label">Reference</label>
                    <input asp-for="Reference" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <input asp-for="Notes" class="form-control" />
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Cancel", Icon = "bi bi-arrow-left", Controller = "Memberships", Action = "Details", RouteValues = new Dictionary<string, string> { { "id", Model.MembershipId.ToString() } }, CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Save Payment", Icon = "bi bi-cash-coin", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
