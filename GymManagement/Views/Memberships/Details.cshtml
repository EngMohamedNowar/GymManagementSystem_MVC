@model MembershipViewModel
@using GymManagementSystem.BLL.ViewModels.Payments

@{
    ViewData["Title"] = "Membership Details";
    var payments = (IEnumerable<PaymentViewModel>?)ViewBag.Payments ?? new List<PaymentViewModel>();

    var headerActions = new List<PageHeaderAction>
    {
        new PageHeaderAction
        {
            Text = "Back",
            Icon = "bi bi-arrow-left",
            Controller = "Memberships",
            Action = "Index",
            CssClass = "btn-outline rounded-pill px-3 py-2"
        },
        new PageHeaderAction
        {
            Text = "Record Payment",
            Icon = "bi bi-cash-coin",
            Controller = "Memberships",
            Action = "RecordPayment",
            RouteValues = new Dictionary<string, string> { { "membershipId", Model.Id.ToString() } },
            CssClass = "btn-fill rounded-pill px-3 py-2"
        }
    };

    if (Model.Status == "Active")
    {
        headerActions.Add(new PageHeaderAction
        {
            Text = "Cancel",
            Icon = "bi bi-x-circle",
            Controller = "Memberships",
            Action = "Cancel",
            RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
            CssClass = "btn-danger-soft rounded-pill px-3 py-2"
        });
    }
    else if (Model.Status != "Active")
    {
        headerActions.Add(new PageHeaderAction
        {
            Text = "Renew",
            Icon = "bi bi-arrow-repeat",
            Controller = "Memberships",
            Action = "Renew",
            RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
            CssClass = "btn-fill rounded-pill px-3 py-2"
        });
    }

    var header = new PageHeaderModel
    {
        Title = Model.PlanName,
        Subtitle = "",
        Actions = headerActions
    };

    string GetStatusBadge(string status)
    {
        var badgeClass = status == "Active" ? "badge-ok" : status == "Cancelled" ? "badge-bad" : "badge-warn";
        return $"<span class=\"badge-soft {badgeClass}\">{status}</span>";
    }
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card mb-4">
        <div class="app-card-body">
            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Plan</span>
                    <span class="detail-val">@Model.PlanName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Price</span>
                    <span class="detail-val">@Model.Price EGP</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Start Date</span>
                    <span class="detail-val">@Model.StartDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">End Date</span>
                    <span class="detail-val">@Model.EndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Status</span>
                    <span class="detail-val">@Html.Raw(GetStatusBadge(Model.Status))</span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-header">
            <h6 class="section-title mb-0">Payments</h6>
            <a asp-action="RecordPayment" asp-route-membershipId="@Model.Id" class="btn btn-soft rounded-pill px-3 py-1">
                <i class="bi bi-plus-lg me-1"></i> Add
            </a>
        </div>
        <div class="app-card-body">
            @if (payments.Any())
            {
                <div class="table-responsive">
                    <table class="table-app">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                <tr>
                                    <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                    <td class="cell-strong">@p.Amount EGP</td>
                                    <td><span class="badge-soft">@p.Method</span></td>
                                    <td>@p.Reference</td>
                                    <td>@p.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_EmptyState", new EmptyStateModel
                {
                    Icon = "bi bi-receipt",
                    Title = "No Payments Yet",
                    Message = "Record a payment for this membership.",
                    Action = new EmptyStateAction
                    {
                        Text = "Record Payment",
                        Icon = "bi bi-plus-lg",
                        Controller = "Memberships",
                        Action = "RecordPayment",
                        RouteValues = new Dictionary<string, string> { { "membershipId", Model.Id.ToString() } },
                        CssClass = "btn-fill rounded-pill px-3"
                    }
                })
            }
        </div>
    </div>
</div>
