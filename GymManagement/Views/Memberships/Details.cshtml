@model MembershipViewModel
@using GymManagementSystem.BLL.ViewModels.Payments

@{
    ViewData["Title"] = "Membership Details";
    var payments = (IEnumerable<PaymentViewModel>?)ViewBag.Payments ?? new List<PaymentViewModel>();

    var header = new PageHeaderModel
    {
        Title = Model.PlanName,
        Subtitle = "",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to List",
                Icon = "bi bi-arrow-left",
                Controller = "Memberships",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Cancel Membership",
                Icon = "bi bi-x-circle",
                Controller = "Memberships",
                Action = "Cancel",
                RouteValues = new { id = Model.Id },
                CssClass = "btn-fill rounded-pill px-3 py-2 btn-danger-soft"
            },
            new PageHeaderAction
            {
                Text = "Renew Membership",
                Icon = "bi bi-arrow-repeat",
                Controller = "Memberships",
                Action = "Renew",
                RouteValues = new { id = Model.Id },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Record Payment",
                Icon = "bi bi-cash-coin",
                Controller = "Memberships",
                Action = "RecordPayment",
                RouteValues = new { membershipId = Model.Id },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };

    // Conditionally show cancel/renew based on status
    if (Model.Status != "Active")
    {
        header.Actions.RemoveAll(a => a.Text == "Cancel Membership");
    }
    if (Model.Status == "Active")
    {
        header.Actions.RemoveAll(a => a.Text == "Renew Membership");
    }
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card mb-4">
        <div class="app-card-body">
            <div class="mb-4">
                <h6 class="section-title"><i class="bi bi-person me-2"></i>Member</h6>
                <p class="mb-0 cell-strong">@Model.MemberName</p>
            </div>

            @await Html.PartialAsync("_DetailList", new DetailListModel
            {
                Items = new List<DetailItem>
                {
                    new DetailItem { Key = "<i class=\"bi bi-tags me-2\"></i>Plan", Value = Model.PlanName },
                    new DetailItem { Key = "<i class=\"bi bi-cash me-2\"></i>Price", Value = $"{Model.Price} EGP" },
                    new DetailItem { Key = "<i class=\"bi bi-calendar me-2\"></i>Start Date", Value = Model.StartDate.ToString("MMM dd, yyyy") },
                    new DetailItem { Key = "<i class=\"bi bi-calendar-x me-2\"></i>End Date", Value = Model.EndDate.ToString("MMM dd, yyyy") },
                    new DetailItem
                    {
                        Key = "<i class=\"bi bi-info-circle me-2\"></i>Status",
                        Value = $"<span class=\"badge-soft {(Model.Status == \"Active\" ? \"badge-ok\" : Model.Status == \"Cancelled\" ? \"badge-bad\" : \"badge-warn\")}\">{Model.Status}</span>"
                    }
                }
            })
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-header">
            <h6 class="section-title mb-0"><i class="bi bi-receipt me-2"></i>Payments</h6>
            <a asp-action="RecordPayment" asp-route-membershipId="@Model.Id" class="btn btn-soft rounded-pill px-3 py-1">
                <i class="bi bi-plus-lg me-1"></i> Add
            </a>
        </div>
        <div class="app-card-body">
            @if (payments.Any())
            {
                <div class="table-responsive">
                    <table class="table-app">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                <tr>
                                    <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                    <td class="cell-strong">@p.Amount EGP</td>
                                    <td><span class="badge-soft">@p.Method</span></td>
                                    <td>@p.Reference</td>
                                    <td>@p.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_EmptyState", new EmptyStateModel
                {
                    Icon = "bi bi-receipt",
                    Title = "No Payments Yet",
                    Message = "Record a payment for this membership.",
                    Action = new EmptyStateAction
                    {
                        Text = "Record Payment",
                        Icon = "bi bi-plus-lg",
                        Controller = "Memberships",
                        Action = "RecordPayment",
                        RouteValues = new { membershipId = Model.Id },
                        CssClass = "btn-fill rounded-pill px-3"
                    }
                })
            }
        </div>
    </div>
</div>