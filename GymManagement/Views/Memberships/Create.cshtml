@model CreateMembershipViewModel

@{
    ViewData["Title"] = "Add Membership";
    var header = new PageHeaderModel { Title = "Add Membership", Subtitle = "Subscribe a member to a plan" };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="Create" method="post" class="form-app">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MemberId" class="form-label">Member</label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PlanId" class="form-label">Plan</label>
                    <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="PlanId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DiscountCode" class="form-label">Discount Code (optional)</label>
                    <input asp-for="DiscountCode" class="form-control" placeholder="e.g. SUMMER25" />
                    <span asp-validation-for="DiscountCode" class="text-danger small"></span>
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Cancel", Icon = "bi bi-arrow-left", Controller = "Memberships", Action = "Index", CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Create Membership", Icon = "bi bi-check-circle", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
