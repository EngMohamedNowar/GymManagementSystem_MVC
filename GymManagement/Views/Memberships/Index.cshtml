@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
    var search = ViewBag.Search?.ToString() ?? "";
    var status = ViewBag.Status?.ToString() ?? "";

    var header = new PageHeaderModel
    {
        Title = "Memberships",
        Subtitle = "Manage member subscriptions to plans",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction { Text = "Add Membership", Icon = "bi bi-plus-lg", Controller = "Memberships", Action = "Create", CssClass = "btn-fill rounded-pill px-3 py-2" }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-card-checklist",
        Title = "No Memberships Available",
        Message = "Add your first membership to get started.",
        Action = new EmptyStateAction { Text = "Add Membership", Icon = "bi bi-plus-lg", Controller = "Memberships", Action = "Create", CssClass = "btn-fill rounded-pill px-3" }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <form method="get" class="form-app mb-3">
        <div class="d-flex gap-2" style="max-width:520px;">
            <input type="text" name="search" value="@search" class="form-control" placeholder="Member or plan" />
            <select name="status" class="form-select" style="max-width:180px;">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(status == "Active")">Active</option>
                <option value="Expired" selected="@(status == "Expired")">Expired</option>
                <option value="Cancelled" selected="@(status == "Cancelled")">Cancelled</option>
            </select>
            <button type="submit" class="btn btn-soft"><i class="bi bi-search"></i></button>
        </div>
    </form>

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Plan</th>
                            <th>Price</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model.Items)
                        {
                            <tr>
                                <td class="cell-strong">@membership.MemberName</td>
                                <td>@membership.PlanName</td>
                                <td>@membership.Price EGP</td>
                                <td>@membership.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@membership.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge-soft @(membership.IsActive ? "badge-ok" : "badge-warn")">@membership.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-action="Details" asp-route-id="@membership.Id"><i class="bi bi-eye"></i></a>
                                        @if (membership.IsActive)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@membership.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn-icon btn-danger-soft" title="Cancel"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>
