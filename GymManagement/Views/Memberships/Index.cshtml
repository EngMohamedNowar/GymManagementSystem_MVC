@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";

    var header = new PageHeaderModel
    {
        Title = "Memberships",
        Subtitle = "Manage member subscriptions to plans",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Add Membership",
                Icon = "bi bi-plus-lg",
                Controller = "Memberships",
                Action = "Create",
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };

    var search = new SearchFormModel
    {
        Controller = "Memberships",
        Action = "Index",
        SearchLabel = "Search",
        SearchPlaceholder = "Member or plan",
        SearchValue = ViewBag.Search?.ToString() ?? "",
        Filters = new List<SearchFilter>
        {
            new SearchFilter
            {
                Name = "status",
                Label = "Status",
                Value = ViewBag.Status?.ToString() ?? "",
                Options = new List<SelectOption>
                {
                    new SelectOption { Value = "Active", Text = "Active" },
                    new SelectOption { Value = "Expired", Text = "Expired" },
                    new SelectOption { Value = "Cancelled", Text = "Cancelled" }
                }
            }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-card-checklist",
        Title = "No Memberships Available",
        Message = "Add your first membership to get started.",
        Action = new EmptyStateAction
        {
            Text = "Add Membership",
            Icon = "bi bi-plus-lg",
            Controller = "Memberships",
            Action = "Create",
            CssClass = "btn-fill rounded-pill px-3"
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)
    @await Html.PartialAsync("_SearchForm", search)

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Plan</th>
                            <th>Price</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model.Items)
                        {
                            <tr>
                                <td class="cell-strong">@membership.MemberName</td>
                                <td>@membership.PlanName</td>
                                <td>@membership.Price EGP</td>
                                <td>@membership.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@membership.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge-soft @(membership.IsActive ? "badge-ok" : "badge-warn")">@membership.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-action="Details" asp-route-id="@membership.Id">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (membership.IsActive)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@membership.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn-icon btn-danger-soft" title="Cancel">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>