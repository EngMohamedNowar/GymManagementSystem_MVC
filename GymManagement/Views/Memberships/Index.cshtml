@model IEnumerable<MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["FailedMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["FailedMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["FlashMessage"] != null)
{
    <div id="Alert" class="alert alert-@(TempData["FlashSuccess"] as bool? == true ? "success" : "danger") alert-dismissible fade show">
        <i class="bi bi-info-circle-fill me-2"></i>
        @TempData["FlashMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Memberships</h2>
            <p class="text-muted">Manage member subscriptions to plans</p>
        </div>
        <a asp-controller="Memberships" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-4 py-3">
            <i class="bi bi-plus-lg me-2"></i>Add Membership
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th><span>Member</span></th>
                        <th><span>Plan</span></th>
                        <th><span>Price</span></th>
                        <th><span>Start Date</span></th>
                        <th><span>End Date</span></th>
                        <th><span>Status</span></th>
                        <th><span>Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var membership in Model)
                    {
                        <tr>
                            <td><span>@membership.MemberName</span></td>
                            <td><span>@membership.PlanName</span></td>
                            <td><span>@membership.Price EGP</span></td>
                            <td><span>@membership.StartDate.ToString("MMM dd, yyyy")</span></td>
                            <td><span>@membership.EndDate.ToString("MMM dd, yyyy")</span></td>
                            <td>
                                <span class="badge @(membership.IsActive ? "bg-success" : "bg-secondary")">@membership.Status</span>
                            </td>
                            <td class="action">
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@membership.Id" class="btn btn-outline btn-sm">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    @if (membership.IsActive)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@membership.Id" method="post">
                                            <button type="submit" class="btn btn-outline text-danger btn-sm">
                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-card-checklist display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Memberships Available</h4>
            <p class="text-muted">Add your first membership to get started</p>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.getElementById("Alert");
        if (alertBox) {
            setTimeout(() => {
                alertBox.style.transition = "opacity 0.5s ease";
                alertBox.style.opacity = "0";
                setTimeout(() => alertBox.remove(), 500);
            }, 1500);
        }
    });
</script>
