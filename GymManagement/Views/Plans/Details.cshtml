@model PlanViewModel

@{
    ViewData["Title"] = "Plan Details";

    var statusBadge = Model.IsActive ? "badge-ok" : "badge-warn";

    var header = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = "",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Plans",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Edit",
                Icon = "bi bi-pencil",
                Controller = "Plans",
                Action = "Edit",
                RouteValues = new { id = Model.Id },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="mb-4 text-center">
                <div class="display-5 fw-bold">@Model.Price <span class="text-muted fs-6">EGP</span></div>
                <span class="badge-soft @statusBadge">@(Model.IsActive ? "Active" : "Inactive")</span>
            </div>

            @await Html.PartialAsync("_DetailList", new DetailListModel
            {
                Items = new List<DetailItem>
                {
                    new DetailItem { Key = "<i class=\"bi bi-tags me-2\"></i>Name", Value = Model.Name },
                    new DetailItem { Key = "<i class=\"bi bi-calendar me-2\"></i>Duration", Value = $"{Model.DurationDays} days" },
                    new DetailItem { Key = "<i class=\"bi bi-cash me-2\"></i>Price", Value = $"{Model.Price} EGP" },
                    new DetailItem { Key = "<i class=\"bi bi-info-circle me-2\"></i>Status", Value = $"<span class=\"badge-soft {statusBadge}\">@(Model.IsActive ? \"Active\" : \"Inactive\")</span>" },
                    new DetailItem { Key = "<i class=\"bi bi-file-text me-2\"></i>Description", Value = Model.Description }
                }
            })
        </div>
    </div>
</div>