@model PlanViewModel

@{
    ViewData["Title"] = "Plan Details";

    var statusBadge = Model.IsActive ? "badge-ok" : "badge-warn";

    var header = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = "",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Plans",
                Action = "Index",
                CssClass = "btn-outline rounded-pill px-3 py-2"
            },
            new PageHeaderAction
            {
                Text = "Edit",
                Icon = "bi bi-pencil",
                Controller = "Plans",
                Action = "Edit",
                RouteValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } },
                CssClass = "btn-fill rounded-pill px-3 py-2"
            }
        }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <div class="mb-4 text-center">
                <div class="display-5 fw-bold">@Model.Price <span class="text-muted fs-6">EGP</span></div>
                <span class="badge-soft @statusBadge">@(Model.IsActive ? "Active" : "Inactive")</span>
            </div>

            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-key">Name</span>
                    <span class="detail-val">@Model.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Duration</span>
                    <span class="detail-val">@Model.DurationDays days</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Price</span>
                    <span class="detail-val">@Model.Price EGP</span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Status</span>
                    <span class="detail-val"><span class="badge-soft @statusBadge">@(Model.IsActive ? "Active" : "Inactive")</span></span>
                </div>
                <div class="detail-row">
                    <span class="detail-key">Description</span>
                    <span class="detail-val">@Model.Description</span>
                </div>
            </div>
        </div>
    </div>
</div>
