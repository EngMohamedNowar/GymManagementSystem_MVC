@model PlanViewModel

@{
    ViewData["Title"] = "Edit Plan";
    var header = new PageHeaderModel { Title = "Edit Plan", Subtitle = "Update plan details" };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="Edit" method="post" class="form-app">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label">Plan Name</label>
                    <input asp-for="Name" class="form-control" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="DurationDays" class="form-label">Duration (Days)</label>
                    <input asp-for="DurationDays" type="number" class="form-control" />
                    <span asp-validation-for="DurationDays" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label">Price (EGP)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Cancel", Icon = "bi bi-arrow-left", Controller = "Plans", Action = "Index", CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Update Plan", Icon = "bi bi-check-circle", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
