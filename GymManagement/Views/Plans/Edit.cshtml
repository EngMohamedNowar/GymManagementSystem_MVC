@model PlanViewModel

@{
    ViewData["Title"] = "Edit Plan";

    var header = new PageHeaderModel
    {
        Title = "Edit Plan",
        Subtitle = "Update plan details",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back",
                Icon = "bi bi-arrow-left",
                Controller = "Plans",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            }
        }
    };

    var backAction = new FormAction
    {
        Text = "Cancel",
        Icon = "bi bi-arrow-left",
        Controller = "Plans",
        Action = "Index",
        CssClass = "btn-soft rounded-pill px-3"
    };

    var submitAction = new FormAction
    {
        Text = "Update Plan",
        Icon = "bi bi-check-lg",
        CssClass = "btn-fill rounded-pill px-3"
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <div class="app-card">
        <div class="app-card-body">
            <form asp-action="Edit" method="post" class="form-app">
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Plan Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DurationDays" class="form-label">
                            <i class="bi bi-calendar-range me-2"></i>Duration (Days) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="DurationDays" type="number" class="form-control" />
                        <small class="text-muted">e.g., 30 days = 1 month</small>
                        <span asp-validation-for="DurationDays" class="text-danger d-block small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">
                            <i class="bi bi-currency-dollar me-2"></i>Price (EGP) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text me-2"></i>Description <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 form-check ps-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold"><i class="bi bi-check-circle me-1"></i>Plan is Active</label>
                    </div>
                </div>

                @await Html.PartialAsync("_FormActions", new FormActionsModel
                {
                    BackAction = backAction,
                    SubmitAction = submitAction
                })
            </form>
        </div>
    </div>
</div>