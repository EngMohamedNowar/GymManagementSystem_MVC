@using GymManagementSystem.BLL.ViewModels.Plans
@using GymManagementSystem.BLL.ViewModels.Common
@model PaginationViewModel<PlanViewModel>

@{
    ViewData["Title"] = "Plans";
    var search = ViewBag.Search?.ToString() ?? "";

    var header = new PageHeaderModel
    {
        Title = "Membership Plans",
        Subtitle = "Manage your gym membership packages",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction { Text = "Add Plan", Icon = "bi bi-plus-lg", Controller = "Plans", Action = "Create", CssClass = "btn-fill rounded-pill px-3 py-2" }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-inbox",
        Title = "No Plans Available",
        Message = "Create your first membership plan to get started.",
        Action = new EmptyStateAction { Text = "Add Plan", Icon = "bi bi-plus-lg", Controller = "Plans", Action = "Create", CssClass = "btn-fill rounded-pill px-3" }
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    <form method="get" class="form-app mb-3" style="max-width:420px;">
        <div class="input-group">
            <input type="text" name="search" value="@search" class="form-control" placeholder="Plan name or description" />
            <button type="submit" class="btn btn-soft"><i class="bi bi-search"></i></button>
        </div>
    </form>

    @if (Model is not null && Model.Items.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th>Price</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="cell-strong">@plan.Name</div>
                                    <div class="cell-sub">@plan.Description</div>
                                </td>
                                <td><span class="cell-strong">@plan.Price</span> <span class="cell-sub">EGP</span></td>
                                <td>@plan.DurationDays days</td>
                                <td>
                                    <span class="badge-soft @(plan.IsActive ? "badge-ok" : "badge-warn")">@(plan.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn-icon" title="Details" asp-action="Details" asp-route-id="@plan.Id"><i class="bi bi-eye"></i></a>
                                        <a class="btn-icon" title="Edit" asp-action="Edit" asp-route-id="@plan.Id"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="ToggleStatus" asp-route-id="@plan.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn-icon @(plan.IsActive ? "btn-danger-soft" : "")" title="@(plan.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(plan.IsActive ? "bi-x-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>
