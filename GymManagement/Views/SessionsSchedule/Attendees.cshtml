@using GymManagementSystem.BLL.ViewModels.Sessions
@model IEnumerable<AttendeeViewModel>

@{
    ViewData["Title"] = "Session Attendees";
    int sessionId = ViewBag.SessionId;

    var header = new PageHeaderModel
    {
        Title = "Session Attendees",
        Subtitle = "Mark who actually showed up to this session",
        Actions = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Text = "Back to Schedule",
                Icon = "bi bi-arrow-left",
                Controller = "SessionsSchedule",
                Action = "Index",
                CssClass = "btn-soft rounded-pill px-3 py-2"
            }
        }
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-people",
        Title = "No Attendees Booked Yet",
        Message = "No one has booked this session so far."
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    @if (Model is not null && Model.Any())
    {
        <div class="app-card">
            <div class="table-responsive">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Phone</th>
                            <th class="text-end">Attendance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attendee in Model)
                        {
                            <tr>
                                <td>@attendee.MemberName</td>
                                <td>@attendee.Phone</td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2">
                                        <form asp-controller="SessionsSchedule" asp-action="MarkAttendance" method="post" class="d-flex align-items-center gap-2 m-0 p-0">
                                            <input type="hidden" name="memberId" value="@attendee.MemberId" />
                                            <input type="hidden" name="sessionId" value="@sessionId" />
                                            <input type="hidden" name="isAttended" value="@(!attendee.IsAttended)" />
                                            <span class="badge-soft @(attendee.IsAttended ? "badge-ok" : "badge-warn")">
                                                @(attendee.IsAttended ? "Attended" : "Not Attended")
                                            </span>
                                            <button type="submit" class="btn btn-soft btn-sm rounded-pill">
                                                <i class="bi @(attendee.IsAttended ? "bi-x-lg" : "bi-check-lg") me-1"></i>
                                                @(attendee.IsAttended ? "Unmark" : "Mark Attended")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>