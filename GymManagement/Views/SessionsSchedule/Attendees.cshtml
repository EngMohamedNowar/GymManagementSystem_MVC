@model IEnumerable<AttendeeViewModel>
@{
    ViewData["Title"] = "Session Attendees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <header class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="text-primary-color">Session Attendees</h3>
            <p class="text-muted">Members booked for this session</p>
        </div>
        <a asp-controller="SessionsSchedule" asp-action="Index" class="btn btn-outline">
            <i class="bi bi-arrow-left me-1"></i>Back to Schedule
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th><span>Member</span></th>
                        <th><span>Phone</span></th>
                        <th><span>Attendance</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attendee in Model)
                    {
                        <tr>
                            <td><span>@attendee.MemberName</span></td>
                            <td><span>@attendee.Phone</span></td>
                            <td>
                                <span class="badge @(attendee.IsAttended ? "bg-success" : "bg-secondary")">
                                    @(attendee.IsAttended ? "Attended" : "Not Attended")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Attendees Booked Yet</h4>
        </div>
    }
</div>
