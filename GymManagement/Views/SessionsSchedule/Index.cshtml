@model IEnumerable<SessionViewModel>
@{
    ViewData["Title"] = "Sessions Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <header class="mt-5 mb-4">
        <h2 class="text-primary-color mb-0">Sessions Schedule</h2>
        <p class="text-muted">Timetable of all training sessions grouped by day</p>
    </header>

    @if (Model != null && Model.Any())
    {
        @foreach (var day in Model.GroupBy(s => s.StartDate.Date).OrderBy(g => g.Key))
        {
            <div class="mb-4">
                <h5 class="text-primary-color mb-3">
                    <i class="bi bi-calendar3 me-2"></i>@day.Key.ToString("dddd, MMM dd, yyyy")
                </h5>
                <div class="table-responsive" style="overflow: visible;">
                    <table class="table table-borderless align-middle">
                        <thead>
                            <tr>
                                <th><span>Time</span></th>
                                <th><span>Category</span></th>
                                <th><span>Trainer</span></th>
                                <th><span>Capacity</span></th>
                                <th><span>Status</span></th>
                                <th><span>Action</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in day.OrderBy(s => s.StartDate))
                            {
                                <tr>
                                    <td><span>@session.TimeRangeDisplay</span></td>
                                    <td><span>@session.CategoryName</span></td>
                                    <td><span>@session.TrainerName</span></td>
                                    <td><span>@session.AvailableSlots/@session.Capacity slots</span></td>
                                    <td>
                                        <span class="badge @(session.Status == "Ongoing" ? "bg-success" : session.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">@session.Status</span>
                                    </td>
                                    <td>
                                        <a asp-controller="SessionsSchedule" asp-action="Attendees" asp-route-id="@session.Id" class="btn btn-outline btn-sm">
                                            <i class="bi bi-people me-1"></i>Attendees
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Sessions Available</h4>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.getElementById("Alert");
        if (alertBox) {
            setTimeout(() => {
                alertBox.style.transition = "opacity 0.5s ease";
                alertBox.style.opacity = "0";
                setTimeout(() => alertBox.remove(), 500);
            }, 1500);
        }
    });
</script>
