@using GymManagementSystem.BLL.ViewModels.Sessions
@model IEnumerable<SessionViewModel>

@{
    ViewData["Title"] = "Sessions Schedule";

    var header = new PageHeaderModel
    {
        Title = "Sessions Schedule",
        Subtitle = "Timetable of all training sessions grouped by day"
    };

    var empty = new EmptyStateModel
    {
        Icon = "bi bi-calendar-x",
        Title = "No Sessions Available",
        Message = "There are no training sessions scheduled right now."
    };
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    @await Html.PartialAsync("_PageHeader", header)

    @if (Model is not null && Model.Any())
    {
        @foreach (var day in Model.GroupBy(s => s.StartDate.Date).OrderBy(g => g.Key))
        {
            <h5 class="section-title"><i class="bi bi-calendar3 me-2"></i>@day.Key.ToString("dddd, MMM dd, yyyy")</h5>
            <div class="app-card mb-4">
                <div class="table-responsive">
                    <table class="table-app">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Category</th>
                                <th>Trainer</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in day.OrderBy(s => s.StartDate))
                            {
                                <tr>
                                    <td>@session.TimeRangeDisplay</td>
                                    <td>@session.CategoryName</td>
                                    <td>@session.TrainerName</td>
                                    <td>@session.AvailableSlots/@session.Capacity slots</td>
                                    <td>
                                        <span class="badge-soft @(session.Status == "Ongoing" ? "badge-ok" : session.Status == "Upcoming" ? "badge-soft" : "badge-warn")">@session.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="SessionsSchedule" asp-action="Attendees" asp-route-id="@session.Id" class="btn btn-soft btn-sm rounded-pill">
                                            <i class="bi bi-people me-1"></i>Attendees
                                        </a>
                                        @if (User.IsInRole("Member") && session.Status == "Upcoming")
                                        {
                                            <form asp-controller="Member" asp-action="BookSession" method="post" class="d-inline">
                                                <input type="hidden" name="sessionId" value="@session.Id" />
                                                <button type="submit" class="btn btn-fill btn-sm rounded-pill">
                                                    <i class="bi bi-check2-circle me-1"></i>Book
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", empty)
    }
</div>
