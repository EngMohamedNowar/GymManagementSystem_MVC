@*
    Unified Action Buttons Partial for Table Rows
    Usage: @(new ActionButtonsModel { ... }.Render(item))
    Or inline in column template
*@
@model GymManagement.PL.Models.ActionButtonsModel

<div class="d-inline-flex gap-1">
    @foreach (var btn in Model.Buttons)
    {
        @btn.Render(Model.Item)
    }
</div>