@using System.Globalization
@using GymManagement.PL.SharedResources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "rtl" : "ltr")" data-bs-theme="dark" data-theme="dark">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <header>
        <!-- ^ navbar -->
        <nav class="navbar navbar-expand-lg sticky-top border-bottom app-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/logo.jpg" alt="Gym Management" style="height:38px;" />
                    <span class="d-none d-sm-inline text-primary-color">GymMS</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>@Localizer["Home"]</a>
                        </li>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>@Localizer["Dashboard"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Members" asp-action="Index"><i class="bi bi-people me-1"></i>@Localizer["Members"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Trainers" asp-action="Index"><i class="bi bi-person-workspace me-1"></i>@Localizer["Trainers"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Sessions" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>@Localizer["Sessions"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Plans" asp-action="Index"><i class="bi bi-tags me-1"></i>@Localizer["Plans"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Memberships" asp-action="Index"><i class="bi bi-credit-card me-1"></i>@Localizer["Memberships"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="SessionsSchedule" asp-action="Index"><i class="bi bi-calendar-week me-1"></i>@Localizer["Schedule"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Discounts" asp-action="Index"><i class="bi bi-percent me-1"></i>@Localizer["Discounts"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Measurements" asp-action="Index"><i class="bi bi-activity me-1"></i>@Localizer["Measurements"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="CheckIn" asp-action="Today"><i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["CheckIn"]</a>
                            </li>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Audit" asp-action="Index"><i class="bi bi-shield-check me-1"></i>@Localizer["Audit"]</a>
                                </li>
                            }
                        }
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link px-3 dropdown-toggle" href="#" id="myAccountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@Localizer["MyAccount"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="myAccountDropdown">
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>@Localizer["MyDashboard"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="MyMembership"><i class="bi bi-credit-card me-1"></i>@Localizer["MyMembership"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="MyBookings"><i class="bi bi-calendar-check me-1"></i>@Localizer["MyBookings"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="MyProfile"><i class="bi bi-person me-1"></i>@Localizer["MyProfile"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="MyQR"><i class="bi bi-qr-code me-1"></i>@Localizer["MyQR"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Measurements" asp-action="Index"><i class="bi bi-activity me-1"></i>@Localizer["Measurements"]</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link px-3 dropdown-toggle" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-translate me-1"></i>@Localizer["Language"]
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="langDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("SetCulture", "Culture", new { culture = "en-US", redirectUri = Context.Request.Path } )">EN</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SetCulture", "Culture", new { culture = "ar-EG", redirectUri = Context.Request.Path } )">ع</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                @await Component.InvokeAsync("NotificationBell")
                            </li>
                            <li class="nav-item">
                                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-fill btn-sm px-3" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["Login"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - GymManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var path = (window.location.pathname || '').toLowerCase();
            var seg = path.split('/').filter(Boolean)[0] || 'home';
            document.querySelectorAll('.app-navbar .navbar-nav > li > a.nav-link').forEach(function (a) {
                var href = (a.getAttribute('href') || '').toLowerCase();
                var cseg = href.split('/').filter(Boolean)[0] || 'home';
                if (cseg === seg) a.classList.add('active');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
