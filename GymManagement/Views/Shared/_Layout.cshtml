<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - GymManagement
    </title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
            /* ===== Compact, professional footer ===== */
            .gym-footer {
                padding: 28px 0 0;
                font-size: 13px;
            }

                .gym-footer .footer-content {
                    gap: 24px;
                    padding-bottom: 18px;
                }

                .gym-footer .footer-logo {
                    font-size: 16px;
                }

                .gym-footer .footer-description {
                    font-size: 12px;
                    margin-top: 6px;
                }

                .gym-footer h6 {
                    font-size: 13px;
                    margin-bottom: 10px;
                }

                .gym-footer .footer-links a {
                    font-size: 12.5px;
                    display: block;
                    margin-bottom: 6px;
                }

                .gym-footer .footer-bottom {
                    padding: 12px 0;
                    font-size: 11.5px;
                }
    </style>

</head>


<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg gym-navbar shadow-sm">

            <div class="container-fluid px-4">


                <!-- Logo -->

                <a class="navbar-brand fw-bold text-white fs-3"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-activity me-2"></i>

                    Gym<span class="brand-highlight">
                    Management
                </span>

            </a>


            <!-- Mobile Menu Button -->

            <button class="navbar-toggler border-0 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Menu -->

            <div class="collapse navbar-collapse"
                 id="navbarSupportedContent">


                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 mt-3 mt-lg-0">


                    <!-- Home -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door"></i>

                            <span>Home</span>

                        </a>

                    </li>


                    <!-- Members -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Members"
                           asp-action="Index">

                            <i class="bi bi-people"></i>

                            <span>Members</span>

                        </a>

                    </li>


                    <!-- Trainers -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Trainers"
                           asp-action="Index">

                            <i class="bi bi-person-badge"></i>

                            <span>Trainers</span>

                        </a>

                    </li>


                    <!-- Sessions -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Sessions"
                           asp-action="Index">

                            <i class="bi bi-calendar-event"></i>

                            <span>Sessions</span>

                        </a>

                    </li>


                    <!-- Plans -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Plans"
                           asp-action="Index">

                            <i class="bi bi-card-checklist"></i>

                            <span>Plans</span>

                        </a>

                    </li>


                    <!-- Memberships -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Memberships"
                           asp-action="Index">

                            <i class="bi bi-person-check"></i>

                            <span>Memberships</span>

                        </a>

                    </li>


                    <!-- Schedule -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="SessionsSchedule"
                           asp-action="Index">

                            <i class="bi bi-calendar3"></i>

                            <span>Schedule</span>

                        </a>

                    </li>


                    <!-- Bookings -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Bookings"
                           asp-action="Index">

                            <i class="bi bi-bookmark-check"></i>

                            <span>Bookings</span>

                        </a>

                    </li>

                </ul>


                <!-- Right Side -->

                <div class="navbar-actions">


                    <!-- Logout -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="logout-btn">

                            <i class="bi bi-box-arrow-right"></i>

                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>

</header>


<!-- ================= MAIN CONTENT ================= -->

<main>

    @RenderBody()

</main>

@{
    var isHomeIndex = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                       && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

@if (isHomeIndex)
{
    <footer class="gym-footer">

        <div class="container">

            <div class="footer-content">

                <!-- Brand -->
                <div class="footer-brand">

                    <div class="footer-logo">
                        <i class="bi bi-activity"></i>

                        Gym
                        <span>Management</span>
                    </div>

                    <p class="footer-description">
                        Manage your gym smarter.
                        Train harder. Grow stronger.
                    </p>

                </div>


                <!-- Quick Links -->
                <div class="footer-links">

                    <h6>Quick Links</h6>

                    <a asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-house-door"></i>
                        Home

                    </a>

                    <a asp-controller="Members"
                       asp-action="Index">

                        <i class="bi bi-people"></i>
                        Members

                    </a>

                    <a asp-controller="Trainers"
                       asp-action="Index">

                        <i class="bi bi-person-badge"></i>
                        Trainers

                    </a>

                    <a asp-controller="Sessions"
                       asp-action="Index">

                        <i class="bi bi-calendar-event"></i>
                        Sessions

                    </a>

                </div>


                <!-- Management -->
                <div class="footer-links">

                    <h6>Management</h6>

                    <a asp-controller="Plans"
                       asp-action="Index">

                        <i class="bi bi-card-checklist"></i>
                        Plans

                    </a>

                    <a asp-controller="Memberships"
                       asp-action="Index">

                        <i class="bi bi-person-check"></i>
                        Memberships

                    </a>

                    <a asp-controller="Bookings"
                       asp-action="Index">

                        <i class="bi bi-bookmark-check"></i>
                        Bookings

                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">

                        <i class="bi bi-shield-check"></i>
                        Privacy

                    </a>

                </div>

            </div>


            <!-- Bottom Footer -->

            <div class="footer-bottom">

                <div class="copyright">

                    <i class="bi bi-c-circle"></i>

                    2026 GymManagement.
                    All rights reserved.

                </div>


                <div class="footer-message">

                    Built for a stronger community

                    <i class="bi bi-heart-fill"></i>

                </div>

            </div>

        </div>

    </footer>
}



<!-- ================= JAVASCRIPT ================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync("Scripts",
                          required: false)

</body>

</html>