@*
    Unified Pagination Partial
    Usage: @await Html.PartialAsync("_Pagination", Model) where Model has CurrentPage, TotalPages, HasPrevious, HasNext
*@
@model GymManagementSystem.BLL.ViewModels.Common.PaginationViewModel<object>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@ViewContext.RouteData.Values["controller"]"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-all-route-data="@GetRouteValues()"
                   tabindex="@(!Model.HasPrevious ? "-1" : "0")"
                   aria-disabled="@(!Model.HasPrevious)">
                    Previous
                </a>
            </li>
            <li class="page-item disabled">
                <span class="page-link" aria-current="page">
                    Page @Model.CurrentPage of @Model.TotalPages
                </span>
            </li>
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@ViewContext.RouteData.Values["controller"]"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-all-route-data="@GetRouteValues()"
                   tabindex="@(!Model.HasNext ? "-1" : "0")"
                   aria-disabled="@(!Model.HasNext)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}

@functions {
    private Dictionary<string, object> GetRouteValues()
    {
        var dict = new Dictionary<string, object>();
        foreach (var key in ViewContext.HttpContext.Request.Query.Keys)
        {
            if (key != "page")
            {
                dict[key] = ViewContext.HttpContext.Request.Query[key].ToString();
            }
        }
        return dict;
    }
}