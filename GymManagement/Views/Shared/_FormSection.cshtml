@*
    Unified Form Section Partial
    Usage: @await Html.PartialAsync("_FormSection", new FormSectionModel { ... })
*@
@model GymManagement.PL.Models.FormSectionModel

@if (!string.IsNullOrEmpty(Model.Title))
{
    <div class="section-title @Model.TitleCssClass">@Model.Title</div>
}

<div class="row g-3">
    @foreach (var field in Model.Fields)
    {
        <div class="@field.ColumnClass">
            <label asp-for="@field.Expression" class="form-label">
                @if (!string.IsNullOrEmpty(field.Icon))
                {
                    <i class="@field.Icon me-2"></i>
                }
                @field.Label
            </label>
            @if (field.IsSelect)
            {
                <select asp-for="@field.Expression" class="form-select" asp-items="@field.SelectItems">
                    @if (!string.IsNullOrEmpty(field.EmptyOptionText))
                    {
                        <option value="">@field.EmptyOptionText</option>
                    }
                </select>
            }
            else if (field.IsTextArea)
            {
                <textarea asp-for="@field.Expression" class="form-control" rows="@field.Rows"></textarea>
            }
            else
            {
                <input asp-for="@field.Expression" class="form-control" placeholder="@field.Placeholder" />
            }
            <span asp-validation-for="@field.Expression" class="text-danger small"></span>
        </div>
    }
</div>