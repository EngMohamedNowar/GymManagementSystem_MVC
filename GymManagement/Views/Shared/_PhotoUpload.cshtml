@*
    Photo Upload Partial with Preview
    Usage: @await Html.PartialAsync("_PhotoUpload", new PhotoUploadModel { Expression = m => m.Photo, ... })
*@
@model GymManagement.PL.Models.PhotoUploadModel

<div class="@Model.ColumnClass">
    <label asp-for="@Model.Expression" class="form-label"></label>
    <div class="d-flex align-items-center gap-3 mb-2">
        <img id="@Model.PreviewId" alt="Photo Preview" class="avatar-lg" style="display:none;" />
        <div class="flex-grow-1">
            <input asp-for="@Model.Expression" class="form-control" id="@Model.InputId" />
            <span asp-validation-for="@Model.Expression" class="text-danger"></span>
        </div>
    </div>
</div>

<script>
    document.getElementById('@Model.InputId').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('@Model.PreviewId');
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
    });
</script>