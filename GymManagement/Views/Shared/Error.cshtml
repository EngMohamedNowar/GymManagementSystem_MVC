@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container">
    @await Html.PartialAsync("_Alerts")
    <div class="app-card mx-auto" style="max-width:640px;">
        <div class="app-card-body text-center py-5">
            <div class="es-icon mx-auto"><i class="bi bi-exclamation-triangle"></i></div>
            <h1 class="h3 mt-3 mb-2">Something went wrong</h1>
            <p class="text-danger fw-semibold mb-1">An error occurred while processing your request.</p>
            <p class="text-muted mb-3">
                We're sorry, something went wrong on our end. The issue has been logged and our team will look into it.
                Please try again later, or return to the <a asp-controller="Home" asp-action="Index">home page</a>.
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>
