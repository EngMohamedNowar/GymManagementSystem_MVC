@model CreateBookingViewModel

@{
    ViewData["Title"] = "New Booking";
    var header = new PageHeaderModel { Title = "New Booking", Subtitle = "Book a member into an upcoming session" };
}

@await Html.PartialAsync("_Alerts")
@await Html.PartialAsync("_PageHeader", header)

<div class="app-card">
    <div class="app-card-body">
        <form asp-action="Create" method="post" class="form-app">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MemberId" class="form-label">Member</label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SessionId" class="form-label">Session</label>
                    <select asp-for="SessionId" asp-items="ViewBag.Sessions" class="form-select">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="SessionId" class="text-danger small"></span>
                </div>
            </div>

            @await Html.PartialAsync("_FormActions", new FormActionsModel
            {
                BackAction = new FormAction { Text = "Cancel", Icon = "bi bi-arrow-left", Controller = "Bookings", Action = "Index", CssClass = "btn-soft rounded-pill px-4" },
                SubmitAction = new FormAction { Text = "Create Booking", Icon = "bi bi-check-circle", CssClass = "btn-fill rounded-pill px-4" }
            })
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
